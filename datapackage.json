     },
     {
      "name": "saifi_excl_major",
      "type": "number",
      "description": "Excluding major event days"
     },
     {
      "name": "us_saidi_minutes_all",
      "type": "number",
      "description": "US customer-weighted average"
     }
    ]
   }
  },
